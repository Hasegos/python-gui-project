# 복사해서 .env 로 저장한 뒤 값을 수정하세요. (.env 는 git 에 올라가지 않습니다)

# 1. 데이터 베이스(Postgresql)
LIBRARY_DB_HOST=localhost
LIBRARY_DB_PORT=5432
LIBRARY_DB_NAME=library
LIBRARY_DB_USER=postgres
LIBRARY_DB_PASSWORD=postgres

# DB 커넥션 풀
LIBRARY_POOL_MIN=1
LIBRARY_POOL_MAX=5

# 2. 대출 정책
LIBRARY_LOAN_DAYS=14
LIBRARY_MAX_LOANS=5
